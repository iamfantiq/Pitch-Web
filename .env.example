# Copy to .env.local for development. On Vercel, set these under Project → Settings → Environment Variables.
# Everything is optional for local development: without them the site uses an embedded database,
# writes emails to .data/outbox and stores uploads in .data/uploads.

# Public URL of the site (links in emails, admin links).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Postgres connection string (Neon or Supabase). Required in production — without it quotes are not kept.
# Vercel → Storage → Create Database → Neon sets this automatically.
DATABASE_URL=

# Email via Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Modular Pitch <offers@your-domain.com>"
# Where new quote notifications go (you).
QUOTE_NOTIFY_EMAIL=

# Logo uploads via Vercel Blob. Vercel → Storage → Create → Blob sets this automatically.
BLOB_READ_WRITE_TOKEN=

# Optional Cloudflare Turnstile spam protection (both keys, or neither).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing IP addresses used in rate limiting (any random string).
RATE_LIMIT_SALT=
# Max quote requests per IP per 10 minutes (default 3).
QUOTE_RATE_LIMIT=
